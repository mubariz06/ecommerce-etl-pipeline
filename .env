# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is already in .gitignore.

# --- Airflow metadata database ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=123456
AIRFLOW_DB_NAME=airflow_metadata

# --- Airflow web UI admin login ---
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=123456

# --- Warehouse (target) database ---
WAREHOUSE_DB_USER=warehouse_user
WAREHOUSE_DB_PASSWORD=123456
WAREHOUSE_DB_NAME=analytics_warehouse
WAREHOUSE_TABLE=fact_orders

# --- Optional: Snowflake (if swapping the warehouse target) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
